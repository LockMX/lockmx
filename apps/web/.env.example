# Copy to .env.local for local overrides. Never commit real values.

# "true" makes every page show the coming soon placeholder (proxy.ts).
# Set in the public deployment until launch; leave unset in development.
COMING_SOON=

# Public origin of the site, without a path: https://lockmx.com in production.
# Used for canonical and alternate addresses. Required by `next build` and
# `next start` (https only); in development it falls back to http://localhost:3000.
SITE_URL=
